{
  "name": "firmware-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "app": "npm run build && electron .",
    "smoke": "npm run build && electron electron/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/spark-md5": "^3.0.5",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitejs/plugin-react": "^4.4.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "electron": "^39.8.10",
    "electron-builder": "^25.1.8",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "esptool-js": "^0.7.0",
    "globals": "^16.0.0",
    "lucide-react": "^1.49.0",
    "png-to-ico": "^3.0.2",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.21.0",
    "spark-md5": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  },
  "productName": "Прошивки Паулюкевичуса",
  "description": "Чтение и заливка прошивок Arduino и ESP32",
  "author": "Паулюкевичус",
  "build": {
    "appId": "ru.pauluk.firmware",
    "productName": "Прошивки Паулюкевичуса",
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "!electron/smoke.mjs",
      "build/icon.png",
      "src/assets/fonts/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Прошивки Паулюкевичуса.exe"
    }
  }
}
